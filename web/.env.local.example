# Copy this file to `.env.local` for local development, and set the SAME two
# variables in the Vercel dashboard (Project → Settings → Environment Variables).

# The URL of your FinChat API (Hugging Face Docker Space).
# The direct Space host looks like this (note ".hf.space", NOT "/spaces/..."):
#   https://<hf-username>-finchat-api.hf.space
BACKEND_URL=https://your-hf-username-finchat-api.hf.space

# Optional shared secret. If you set API_SECRET as a secret on the HF Space,
# put the SAME value here so the proxy can authenticate to it.
# Leave blank if you did not set one on the Space.
API_SECRET=
